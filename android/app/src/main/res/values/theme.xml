<resources>
    <color name="surface">#F4F6F3</color>
    <color name="panel">#FFFFFF</color>
    <color name="field">#E8EEEA</color>
    <color name="ink">#152620</color>
    <color name="muted">#4D6058</color>
    <color name="line">#CCD8D1</color>
    <color name="accent">#006B5D</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="danger">#A32C25</color>
    <color name="warn">#9A5800</color>
    <color name="private_ink">#6A3FA0</color>
    <color name="private_field">#ECE3F7</color>

    <style name="Theme.PouBrowser" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:alertDialogTheme">@style/Theme.PouBrowser.Dialog</item>
        <item name="android:popupMenuStyle">@style/PouBrowser.PopupMenu</item>
    </style>

    <!-- Dialogs and menus as rounded cards with sentence-case buttons, like the iOS app and current Android apps. -->
    <style name="Theme.PouBrowser.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:buttonBarButtonStyle">@style/PouBrowser.DialogButton</item>
    </style>
    <style name="PouBrowser.DialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="PouBrowser.PopupMenu" parent="android:style/Widget.Material.Light.PopupMenu">
        <item name="android:popupBackground">@drawable/menu_background</item>
        <item name="android:popupElevation">8dp</item>
    </style>
</resources>
